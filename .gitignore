# extracted outputs
sources/generated/*
!sources/generated/.gitkeep
mappings/results/*
!mappings/results/.gitkeep
mappings/target_catalogs/*
!mappings/target_catalogs/.gitkeep

# user-generated chat conversations
chat_history/

# VS Code workspace files
*.code-workspace

# Python
__pycache__/
*.py[cod]
.env
*.egg-info/
dist/
.venv/
venv/

# Local-only Figma reference screenshots (downloaded via the Figma MCP for visual diffing)
.figma_refs/

# Old raw chat-session-history dump (not real instructions/config), accidentally tracked at
# repo-reset time — 229MB, never commit
.github/instructions/projectinstructions.json

# RAG indexes and large source files (rebuild locally, see README)
rag/dpm/dpm_index.faiss
rag/dpm/dpm_index.txt
rag/dpm/dpm_cells.json
rag/dpm/DPM2.0.accdb
# Raw DPM data model export (regenerated from DPM2.0.accdb via generate_dpm_yaml.py, 73MB —
# same "rebuild locally, don't commit" category as its siblings above)
rag/dpm/dpm2.0.yaml

# Frontend (Vue 3 + Vite + Quasar)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.quasar/
frontend/.vite/
frontend/*.local
frontend/tsconfig.tsbuildinfo

# Logs
*.log

# Local-only demo and planning artefacts
diagram.html
plan-dataGovernancePlatformFeatures.prompt.md
ADM_Demo_Overview.html

# All docs are local-only: the ENTIRE docs/ tree is ignored (architecture,
# archive, continuous_sessions, handover-prompts, closing reports, design specs).
# To share a specific doc later, add a negation AFTER this line, e.g.:
#   !docs/architecture/
#   !docs/architecture/some-shared-spec.md
docs/
.github/prompts/

# Throwaway investigation scripts (spikes). The findings they produce live in docs/;
# the scripts themselves are scratch and are deleted once their output lands as real code.
.spike/

# Audit log (DuckDB-backed, append-only) — root-level runtime data only.
# Anchored with a leading slash so it does NOT match the tracked source
# package core/audit/ (a bare `audit/` matches an `audit` dir at any depth).
/audit/

# Governance state stores (app-generated runtime data, never commit)
# NOTE: this folder also holds hand-authored config (governed vocabulary,
# DQ scoring model) which IS tracked — see the negations below. Only
# per-column/table state generated by resolving/profiling/steward actions
# stays ignored (element_states.yaml, semantic_type_assignments.yaml,
# dq_scores.yaml, etc.). reference_sets.yaml was archived to
# docs/archive/yaml_migration/ (2026-08-18) once its data was fully migrated
# to Postgres (reference_set/reference_set_entry) — no longer tracked here.
governance/*
!governance/.gitkeep
!governance/semantic_types.yaml
!governance/dq_scoring_config.yaml

# BIRD KB generated database (rebuild with loader — never commit)
knowledge_base/bird/data/*.duckdb

# Full BIRD SMCube export (~50MB, all frameworks — re-download from the ECB
# rather than committing; git would keep it forever)
knowledge_base/bird/source/BIRD_all-frameworks_*.xlsx

# Shared alm_bank/faker/kaggle raw duckdb (911MB, copied from external ADM
# repo — too large to commit, rebuild by copying from source if ever needed)
sources/duckdb/almb_faker_kaggle.duckdb

# Kaggle raw source files (~1.35GB — too large to commit)
sources/original/cards_data.csv
sources/original/mcc_codes.json
sources/original/train_fraud_labels.json
sources/original/transactions_data.csv
sources/original/users_data.csv


